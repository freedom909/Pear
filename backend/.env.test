# Test environment configuration
NODE_ENV=test
PORT=4000

# Database
TEST_DB_URI=mongodb://localhost:27017/pear_test

# JWT
JWT_SECRET=test_jwt_secret
JWT_EXPIRES_IN=90d

# OAuth
GOOGLE_CLIENT_ID=test_google_client_id
GOOGLE_CLIENT_SECRET=test_google_client_secret
FACEBOOK_APP_ID=test_facebook_app_id
FACEBOOK_APP_SECRET=test_facebook_app_secret
TWITTER_CONSUMER_KEY=test_twitter_consumer_key
TWITTER_CONSUMER_SECRET=test_twitter_consumer_secret
APPLE_CLIENT_ID=test_apple_client_id
APPLE_TEAM_ID=test_apple_team_id
APPLE_KEY_ID=test_apple_key_id
APPLE_PRIVATE_KEY=test_apple_private_key

# Email
EMAIL_FROM=test@example.com
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USERNAME=test_username
EMAIL_PASSWORD=test_password